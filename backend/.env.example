# Application Configuration
APP_NAME=EcommerceHub-Core
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Security & Multi-Tenancy
JWT_SECRET_KEY=supersecretkey_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL / Neon Serverless)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce_hub

# Payment Gateways (Subaccount & Split Routing)
PLATFORM_FEE_PERCENTAGE=2.5
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_WEBHOOK_SECRET=whsec_placeholder

# Sanity CMS (Interchangeable Adapter)
SANITY_PROJECT_ID=placeholder
SANITY_DATASET=production
SANITY_API_TOKEN=placeholder
